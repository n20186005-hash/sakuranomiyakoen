# Dependencies — installed locally, never uploaded
node_modules/

# Build output — generated by `pnpm build`, served by Cloudflare Workers (assets.directory: ./dist)
# For manual Workers deploy: run build, then `wrangler deploy` uploads ./dist. Do not commit it.
dist/

# Astro / Vite cache
.astro/
.vite/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Environment / secrets — keep keys out of the repo
.env
.env.*
!.env.example

# OS & editor clutter
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Cloudflare local state
.wrangler/
.dev.vars
