---
import type { Attraction } from '@/data/site';
type Props = { attraction: Attraction; index?: number };
const { attraction, index = 0 } = Astro.props;
---
<article id={attraction.slug} class="group scroll-mt-28 overflow-hidden rounded-3xl border border-ink/10 bg-white/65 shadow-soft">
  <figure class="photo-frame aspect-[16/10] rounded-none">
    <img src={attraction.image} alt={attraction.imageAlt} width="1400" height="875" loading={index < 2 ? 'eager' : 'lazy'} />
  </figure>
  <div class="p-6 sm:p-7">
    <div class="flex items-center justify-between gap-4">
      <p class="text-xs font-semibold tracking-[0.2em] text-moss">{attraction.eyebrow}</p>
      <span class="font-jp-serif text-sm text-sakura">{String(index + 1).padStart(2, '0')}</span>
    </div>
    <h2 class="font-jp-serif mt-3 text-2xl tracking-wider text-ink">{attraction.name}</h2>
    <p class="mt-4 text-sm leading-7 text-ink/80">{attraction.summary}</p>
    <p class="mt-3 text-sm leading-7 text-muted">{attraction.details}</p>
    <dl class="mt-5 flex flex-wrap gap-x-6 gap-y-2 border-t border-ink/10 pt-4 text-xs">
      <div><dt class="inline text-muted">最寄り：</dt><dd class="inline font-medium text-ink">{attraction.nearest}</dd></div>
      <div><dt class="inline text-muted">目安：</dt><dd class="inline font-medium text-ink">{attraction.time}</dd></div>
    </dl>
  </div>
</article>
