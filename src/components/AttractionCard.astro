---
import type { Attraction } from '@/data/site';
import { useTranslations, localize } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

type Props = { attraction: Attraction; index?: number; lang?: Locale };
const { attraction, index = 0, lang = 'ja' } = Astro.props;
const { t } = useTranslations(lang);
const a = localize('attractions', attraction, lang);
const c = t('comp.cards') as Record<string, string>;
---
<article id={a.slug} class="group scroll-mt-28 overflow-hidden rounded-3xl border border-ink/10 bg-white/65 shadow-soft">
  <figure class="photo-frame aspect-[16/10] rounded-none">
    <img src={a.image} alt={a.imageAlt} width="1400" height="875" loading={index < 2 ? 'eager' : 'lazy'} />
  </figure>
  <div class="p-6 sm:p-7">
    <div class="flex items-center justify-between gap-4">
      <p class="text-xs font-semibold tracking-[0.2em] text-moss">{a.eyebrow}</p>
      <span class="font-jp-serif text-sm text-sakura">{String(index + 1).padStart(2, '0')}</span>
    </div>
    <h2 class="font-jp-serif mt-3 text-2xl tracking-wider text-ink">{a.name}</h2>
    <p class="mt-4 text-sm leading-7 text-ink/80">{a.summary}</p>
    <p class="mt-3 text-sm leading-7 text-muted">{a.details}</p>
    <dl class="mt-5 flex flex-wrap gap-x-6 gap-y-2 border-t border-ink/10 pt-4 text-xs">
      <div><dt class="inline text-muted">{c.nearest}：</dt><dd class="inline font-medium text-ink">{a.nearest}</dd></div>
      <div><dt class="inline text-muted">{c.time}：</dt><dd class="inline font-medium text-ink">{a.time}</dd></div>
    </dl>
  </div>
</article>
