---
import { useTranslations, localePath } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

type Props = { lang?: Locale };
const { lang = 'ja' } = Astro.props;
const { t } = useTranslations(lang);
const policyLabels = {
  ja: ['プライバシーポリシー', '利用規約', 'Cookie 設定'],
  en: ['Privacy Policy', 'Terms of Service', 'Cookie Settings'],
  'zh-tw': ['隱私政策', '服務條款', 'Cookie 設定'],
  ko: ['개인정보 처리방침', '이용약관', 'Cookie 설정'],
} as const;
const policyLinks = ['privacy-policy', 'terms-of-service', 'cookie-settings'];
---
<footer class="mt-20 border-t border-ink/10 bg-paper/60">
  <div class="mx-auto flex max-w-7xl flex-col gap-5 px-5 py-9 text-sm md:flex-row md:items-center md:justify-between lg:px-8">
    <p class="text-ink/80">© 2026 {lang === 'ja' ? '毛馬桜之宮公園' : lang === 'en' ? 'Kema Sakuranomiya Park' : lang === 'zh-tw' ? '毛馬櫻之宮公園' : '게마 사쿠라노미야 공원'} · {lang === 'ja' ? '無断転載禁止' : lang === 'en' ? 'All rights reserved' : lang === 'zh-tw' ? '版權所有' : '모든 권리 보유'}</p>
    <nav aria-label="Legal policies" class="flex flex-wrap gap-x-5 gap-y-2">
      {policyLinks.map((slug, i) => <a href={localePath(`/${slug}/`, lang)} class="text-ink/80 underline-offset-4 hover:text-moss hover:underline">{policyLabels[lang][i]}</a>)}
    </nav>
  </div>
</footer>
