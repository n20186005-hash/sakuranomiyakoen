---
import { useTranslations, localePath } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

type Props = { lang?: Locale };
const { lang = 'ja' } = Astro.props;
const { t } = useTranslations(lang);
const guide = t('nav.guide') as Array<{ href: string; label: string }>;
const info = t('nav.info') as Array<{ href: string; label: string }>;
const hrefFor = (href: string) => (['/nearby/', '/photo/', '/credits/', '/privacy/'].includes(href) ? href : localePath(href, lang));
---
<footer class="mt-20 border-t border-ink/10 bg-paper/60">
  <div class="mx-auto max-w-7xl px-5 py-14 lg:px-8">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <p class="font-jp-serif text-lg tracking-wider text-ink">KEMA 桜之宮 <span class="text-moss">非公式ガイド</span></p>
        <p class="mt-3 max-w-sm text-sm leading-7 text-muted">{t('nav.footerDesc')}</p>
      </div>

      <div>
        <p class="text-xs font-semibold tracking-[0.2em] text-muted">{t('nav.guideTitle')}</p>
        <ul class="mt-4 grid gap-2 text-sm">
          {
            guide.map((item) => (
              <li><a href={hrefFor(item.href)} class="text-ink/80 transition hover:text-moss">{item.label}</a></li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold tracking-[0.2em] text-muted">{t('nav.infoTitle')}</p>
        <ul class="mt-4 grid gap-2 text-sm">
          {
            info.map((item) => (
              <li><a href={hrefFor(item.href)} class="text-ink/80 transition hover:text-moss">{item.label}</a></li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="mt-10 border-t border-ink/10 pt-6 text-xs text-muted">{t('nav.nonOfficial')}</p>
  </div>
</footer>
