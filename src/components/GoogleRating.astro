---
import SectionHeading from '@/components/SectionHeading.astro';
import { reviews } from '@/data/site';
import { useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

type Props = { lang?: Locale };
const { lang = 'ja' } = Astro.props;
const { t } = useTranslations(lang);
const fillPercent = Math.round((reviews.rating / 5) * 100);
const reviewUrl = reviews.mapsUrl;
---
<section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
  <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
    <SectionHeading
      eyebrow={t('comp.googleRating.eyebrow')}
      title={t('comp.googleRating.title')}
      description={`${t('comp.googleRating.descPre')}${reviews.syncMonth}${t('comp.googleRating.descPost')}`}
    />
  </div>

  <div class="mt-10 overflow-hidden rounded-[2rem] border border-ink/10 bg-white/70 p-8 shadow-soft sm:p-12">
    <p class="text-xs leading-6 text-muted">
      {t('comp.googleRating.lead')}<a href={reviewUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-river-deep hover:text-moss">{t('comp.googleRating.leadLink')}</a>
    </p>

    <div class="mt-6 flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex items-center gap-6">
        <div class="grid size-16 shrink-0 place-items-center rounded-2xl bg-moss text-white">
          <span class="sakura-mark" aria-hidden="true"></span>
        </div>
        <div>
          <p class="text-xs font-semibold tracking-[0.2em] text-muted">{t('comp.googleRating.label')}</p>
          <div class="mt-1 flex items-end gap-3">
            <span class="font-jp-serif text-5xl leading-none text-ink">{reviews.rating.toFixed(1)}</span>
            <span class="pb-1 text-sm text-muted">／ 5（{reviews.count.toLocaleString()}{t('comp.googleRating.count')}）</span>
          </div>
          <div class="mt-2" role="img" aria-label={`${t('comp.googleRating.ariaLabel')} ${reviews.rating} ${reviews.count}`}>
            <span class="relative inline-block text-2xl leading-none">
              <span class="text-sakura-soft/60">★★★★★</span>
              <span class="absolute inset-0 overflow-hidden text-gold" style={`width:${fillPercent}%`}>★★★★★</span>
            </span>
          </div>
        </div>
      </div>

      <div class="lg:max-w-xs">
        <a
          href={reviewUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-moss px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-moss-dark"
        >
          {t('comp.googleRating.button')}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="mt-8 border-t border-ink/10 pt-6">
      <p class="text-xs leading-6 text-muted">
        {t('comp.googleRating.sync1')}{reviews.syncMonth}{t('comp.googleRating.sync2')}
      </p>
    </div>
  </div>
</section>
