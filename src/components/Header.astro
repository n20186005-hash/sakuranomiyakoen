---
import { useTranslations, localePath } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

type Props = { lang?: Locale };
const { lang = 'ja' } = Astro.props;
const { t } = useTranslations(lang);
const nav = t('nav.main') as Array<{ href: string; label: string }>;
const hrefFor = (href: string) => (href === '/nearby/' ? href : localePath(href, lang));
---
<header class="sticky top-0 z-50 border-b border-ink/5 bg-paper/80 backdrop-blur supports-[backdrop-filter]:bg-paper/60">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 lg:px-8" aria-label={t('nav.ariaMain')}>
    <a href={localePath('/', lang)} class="font-jp-serif text-xl tracking-wider text-ink">
      KEMA<span class="text-moss">桜之宮</span>
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        nav.map((item) => (
          <li><a href={hrefFor(item.href)} class="relative text-sm text-ink/80 transition hover:text-moss after:absolute after:-bottom-1.5 after:left-0 after:h-px after:w-0 after:bg-moss after:transition-all hover:after:w-full">{item.label}</a></li>
        ))
      }
    </ul>

    <button id="menu-toggle" type="button" class="rounded-lg border border-ink/15 px-4 py-2 text-sm font-medium text-ink md:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label={t('nav.ariaOpen')} data-open={t('nav.ariaOpen')} data-close={t('nav.ariaClose')}>
      <span class="menu-text">MENU</span>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-ink/10 bg-paper md:hidden">
    <ul class="mx-auto max-w-7xl grid gap-1 px-5 py-4" aria-label={t('nav.ariaMobile')}>
      {
        nav.map((item) => (
          <li><a href={hrefFor(item.href)} class="block rounded-xl px-3 py-3 text-base text-ink/90 hover:bg-white/70">{item.label}</a></li>
        ))
      }
      <li><a href={localePath('/rules/', lang)} class="block rounded-xl px-3 py-3 text-base text-ink/90 hover:bg-white/70">{t('nav.rules')}</a></li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      menu.classList.toggle('hidden');
      toggle.setAttribute('aria-label', expanded ? (toggle.dataset.open ?? '') : (toggle.dataset.close ?? ''));
    });
  }
</script>
