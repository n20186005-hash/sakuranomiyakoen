---
type Props = { title: string; tone?: 'sakura' | 'river' | 'moss' };
const { title, tone = 'sakura' } = Astro.props;
const toneClass = {
  sakura: 'border-sakura/40 bg-sakura-soft/45',
  river: 'border-river/30 bg-river/8',
  moss: 'border-moss/25 bg-moss/8',
}[tone];
---
<aside class:list={['rounded-2xl border p-5 sm:p-6', toneClass]}>
  <h2 class="font-jp-serif text-xl tracking-wider text-ink">{title}</h2>
  <div class="mt-3 text-sm leading-7 text-muted"><slot /></div>
</aside>
