---
type Props = { compact?: boolean };
const { compact = false } = Astro.props;
---
<div class="rounded-[2rem] border border-ink/10 bg-white/65 p-4 shadow-soft sm:p-7">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3 px-2">
    <div>
      <p class="text-xs font-semibold tracking-[0.18em] text-moss">WALKING SCHEMATIC</p>
      <h3 class="font-jp-serif mt-1 text-xl tracking-wider">大川沿いの歩き方・概念図</h3>
    </div>
    <p class="text-xs text-muted">※縮尺・方位を省略した案内図です</p>
  </div>
  <svg viewBox={compact ? '0 0 900 420' : '0 0 900 520'} class="h-auto w-full" role="img" aria-labelledby="map-title map-desc">
    <title id="map-title">毛馬桜之宮公園の散歩ルート概念図</title>
    <desc id="map-desc">北の桜ノ宮駅から大川沿いを南へ歩き、旧桜宮公会堂、泉布観、藤田邸跡公園、藤田美術館を経て天満橋へ向かう概念図。</desc>
    <defs>
      <linearGradient id="riverGradient" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#7fa4ad" />
        <stop offset="1" stop-color="#527b86" />
      </linearGradient>
      <pattern id="waterLines" width="28" height="16" patternUnits="userSpaceOnUse">
        <path d="M0 8 Q7 2 14 8 T28 8" fill="none" stroke="#fff" stroke-opacity=".24" stroke-width="1.5" />
      </pattern>
    </defs>

    <rect x="0" y="0" width="900" height={compact ? 420 : 520} rx="26" fill="#f7f3ec" />
    <path d="M465 -20 C360 80 565 145 430 235 C335 300 540 355 405 540" fill="none" stroke="url(#riverGradient)" stroke-width="135" stroke-linecap="round" />
    <path d="M465 -20 C360 80 565 145 430 235 C335 300 540 355 405 540" fill="none" stroke="url(#waterLines)" stroke-width="120" stroke-linecap="round" />

    <path d="M350 20 C270 95 420 155 300 235 C245 275 325 335 290 395" fill="none" stroke="#e5aeb9" stroke-width="8" stroke-linecap="round" stroke-dasharray="3 15" />
    <path d="M575 25 C485 95 630 155 530 235 C470 285 555 345 505 430" fill="none" stroke="#e5aeb9" stroke-width="8" stroke-linecap="round" stroke-dasharray="3 15" />

    <g font-family="sans-serif" font-size="14" fill="#26312d">
      <g transform="translate(90 42)">
        <circle cx="18" cy="18" r="16" fill="#435f54" />
        <circle cx="18" cy="18" r="5" fill="#f3d9de" />
        <text x="46" y="15" font-weight="700">JR 桜ノ宮駅</text>
        <text x="46" y="36" fill="#66716c" font-size="12">短時間コースの入口</text>
      </g>

      <g transform="translate(575 105)">
        <circle cx="15" cy="15" r="12" fill="#fff" stroke="#435f54" stroke-width="3" />
        <text x="38" y="13" font-weight="700">源八橋</text>
        <text x="38" y="32" fill="#66716c" font-size="12">桜と川の広がり</text>
      </g>

      <g transform="translate(95 165)">
        <circle cx="15" cy="15" r="12" fill="#fff" stroke="#527b86" stroke-width="3" />
        <text x="38" y="13" font-weight="700">桜ノ宮ビーチ</text>
        <text x="38" y="32" fill="#66716c" font-size="12">親水空間</text>
      </g>

      <g transform="translate(590 235)">
        <circle cx="15" cy="15" r="12" fill="#fff" stroke="#a98c58" stroke-width="3" />
        <text x="38" y="13" font-weight="700">旧桜宮公会堂・泉布観</text>
        <text x="38" y="32" fill="#66716c" font-size="12">近代建築を歩く</text>
      </g>

      <g transform="translate(75 300)">
        <circle cx="15" cy="15" r="12" fill="#fff" stroke="#435f54" stroke-width="3" />
        <text x="38" y="13" font-weight="700">藤田邸跡公園</text>
        <text x="38" y="32" fill="#66716c" font-size="12">庭園と休憩</text>
      </g>

      <g transform="translate(580 360)">
        <circle cx="15" cy="15" r="12" fill="#fff" stroke="#a98c58" stroke-width="3" />
        <text x="38" y="13" font-weight="700">藤田美術館</text>
        <text x="38" y="32" fill="#66716c" font-size="12">大阪城北詰駅に近い</text>
      </g>

      {!compact && (
        <g transform="translate(80 438)">
          <circle cx="18" cy="18" r="16" fill="#435f54" />
          <circle cx="18" cy="18" r="5" fill="#f3d9de" />
          <text x="46" y="15" font-weight="700">天満橋駅</text>
          <text x="46" y="36" fill="#66716c" font-size="12">公園南端・造幣局方面</text>
        </g>
      )}
    </g>

    <g transform="translate(690 455)" font-family="sans-serif" font-size="12" fill="#66716c">
      {!compact && <text x="0" y="0">北</text>}
      {!compact && <path d="M12 12V45m0-33-6 9m6-9 6 9" stroke="#66716c" stroke-width="1.5" fill="none" />}
    </g>
  </svg>
</div>
