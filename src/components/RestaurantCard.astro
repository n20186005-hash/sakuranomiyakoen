---
import type { Restaurant } from '@/data/site';
type Props = { restaurant: Restaurant; index?: number };
const { restaurant, index = 0 } = Astro.props;
---
<article class="rounded-3xl border border-ink/10 bg-white/65 p-6 shadow-soft sm:p-7" data-restaurant data-tags={restaurant.tags.join(' ')} data-category={restaurant.category}>
  <div class="flex items-start justify-between gap-5">
    <div>
      <p class="text-xs font-semibold tracking-[0.18em] text-moss">{restaurant.category}</p>
      <h2 class="font-jp-serif mt-2 text-xl leading-snug tracking-wider text-ink">{restaurant.name}</h2>
    </div>
    <span class="font-jp-serif text-xl text-sakura/70">{String(index + 1).padStart(2, '0')}</span>
  </div>

  <p class="mt-4 text-sm leading-7 text-muted">{restaurant.note}</p>

  <dl class="mt-5 grid gap-3 border-t border-ink/10 pt-5 text-sm">
    <div class="flex justify-between gap-5"><dt class="text-muted">エリア</dt><dd class="text-right font-medium text-ink">{restaurant.station}</dd></div>
    <div class="flex justify-between gap-5"><dt class="text-muted">徒歩</dt><dd class="text-right font-medium text-ink">{restaurant.walk}</dd></div>
    <div class="flex justify-between gap-5"><dt class="text-muted">予算目安</dt><dd class="text-right font-medium text-ink">{restaurant.budget}</dd></div>
    <div class="flex justify-between gap-5"><dt class="text-muted">営業時間</dt><dd class="text-right font-medium text-ink">{restaurant.hours}</dd></div>
    <div class="flex justify-between gap-5"><dt class="text-muted">休み</dt><dd class="text-right font-medium text-ink">{restaurant.closed}</dd></div>
  </dl>

  <div class="mt-5 flex flex-wrap gap-2">
    {restaurant.tags.map((tag) => <span class="rounded-full bg-paper px-3 py-1.5 text-xs text-muted">{tag}</span>)}
  </div>
</article>
