---
import type { Restaurant } from '@/data/site';
import { useTranslations, localize } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

type Props = { restaurant: Restaurant; index?: number; lang?: Locale };
const { restaurant, index = 0, lang = 'ja' } = Astro.props;
const { t } = useTranslations(lang);
const r = localize('restaurants', restaurant, lang);
// フィルター用データ属性はベース（ja）のキーを使う
const baseTags = restaurant.tags.join(' ');
const baseCategory = restaurant.category;
const c = t('comp.cards') as Record<string, string>;
---
<article class="rounded-3xl border border-ink/10 bg-white/65 p-6 shadow-soft sm:p-7" data-restaurant data-tags={baseTags} data-category={baseCategory}>
  <div class="flex items-start justify-between gap-5">
    <div>
      <p class="text-xs font-semibold tracking-[0.18em] text-moss">{r.category}</p>
      <h2 class="font-jp-serif mt-2 text-xl leading-snug tracking-wider text-ink">{r.name}</h2>
    </div>
    <span class="font-jp-serif text-xl text-sakura/70">{String(index + 1).padStart(2, '0')}</span>
  </div>

  <p class="mt-4 text-sm leading-7 text-muted">{r.note}</p>

  <dl class="mt-5 grid gap-3 border-t border-ink/10 pt-5 text-sm">
    <div class="flex justify-between gap-5"><dt class="text-muted">{c.area}</dt><dd class="text-right font-medium text-ink">{r.station}</dd></div>
    <div class="flex justify-between gap-5"><dt class="text-muted">{c.walk}</dt><dd class="text-right font-medium text-ink">{r.walk}</dd></div>
    <div class="flex justify-between gap-5"><dt class="text-muted">{c.budget}</dt><dd class="text-right font-medium text-ink">{r.budget}</dd></div>
    <div class="flex justify-between gap-5"><dt class="text-muted">{c.hours}</dt><dd class="text-right font-medium text-ink">{r.hours}</dd></div>
    <div class="flex justify-between gap-5"><dt class="text-muted">{c.closed}</dt><dd class="text-right font-medium text-ink">{r.closed}</dd></div>
  </dl>

  <div class="mt-5 flex flex-wrap gap-2">
    {r.tags.map((tag: string) => <span class="rounded-full bg-paper px-3 py-1.5 text-xs text-muted">{tag}</span>)}
  </div>
</article>
