---
import type { Route } from '@/data/site';
type Props = { route: Route; featured?: boolean };
const { route, featured = false } = Astro.props;
---
<article id={route.slug} class:list={[
  'scroll-mt-28 overflow-hidden rounded-3xl border border-ink/10 bg-white/65 shadow-soft',
  featured && 'ring-1 ring-sakura/60',
]}>
  <div class="grid lg:grid-cols-[0.9fr_1.1fr]">
    <figure class="photo-frame min-h-72 rounded-none lg:min-h-full">
      <img src={route.image} alt={route.imageAlt} width="1600" height="1000" loading="lazy" />
    </figure>
    <div class="p-7 sm:p-9">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full bg-moss px-3 py-1 text-xs font-semibold text-white">{route.duration}分</span>
        <span class="rounded-full bg-river/10 px-3 py-1 text-xs font-semibold text-river-deep">{route.distance}</span>
        {featured && <span class="rounded-full bg-sakura-soft px-3 py-1 text-xs font-semibold text-moss-dark">おすすめ</span>}
      </div>
      <h2 class="font-jp-serif mt-5 text-3xl leading-snug tracking-wider text-ink">{route.title}</h2>
      <p class="mt-3 text-sm font-medium text-river-deep">{route.mood}</p>
      <p class="mt-5 text-sm leading-7 text-muted">{route.description}</p>

      <dl class="mt-6 grid gap-3 text-sm sm:grid-cols-2">
        <div class="rounded-xl bg-paper p-4">
          <dt class="text-xs text-muted">出発</dt>
          <dd class="mt-1 font-medium text-ink">{route.start}</dd>
        </div>
        <div class="rounded-xl bg-paper p-4">
          <dt class="text-xs text-muted">到着</dt>
          <dd class="mt-1 font-medium text-ink">{route.end}</dd>
        </div>
      </dl>

      <div class="mt-7">
        <h3 class="text-xs font-semibold tracking-[0.18em] text-muted">歩く順番</h3>
        <ol class="route-line mt-4 ml-2 grid gap-3 pl-6">
          {route.steps.map((step, index) => (
            <li class="relative text-sm leading-6 text-ink">
              <span class="absolute -left-[1.82rem] top-0.5 grid size-5 place-items-center rounded-full bg-river text-[10px] font-semibold text-white">{index + 1}</span>
              {step}
            </li>
          ))}
        </ol>
      </div>

      <div class="mt-7 flex flex-wrap gap-2">
        {route.tags.map((tag) => <span class="rounded-full border border-ink/10 px-3 py-1.5 text-xs text-muted">#{tag}</span>)}
      </div>
    </div>
  </div>
</article>
