---
import { routes } from '@/data/site';
const routeData = routes.map(({ slug, title, duration, distance, start, end, mood, tags, suitableFor }) => ({
  slug, title, duration, distance, start, end, mood, tags, suitableFor,
}));
---
<section class="mx-auto max-w-7xl px-5 py-20 lg:px-8" aria-labelledby="route-finder-title">
  <div class="overflow-hidden rounded-[2rem] bg-moss-dark text-white shadow-soft">
    <div class="grid lg:grid-cols-[0.8fr_1.2fr]">
      <div class="paper-noise border-b border-white/10 p-7 sm:p-10 lg:border-b-0 lg:border-r">
        <p class="text-xs font-semibold tracking-[0.25em] text-sakura-soft">ROUTE FINDER</p>
        <h2 id="route-finder-title" class="font-jp-serif mt-4 text-3xl leading-snug tracking-wider sm:text-4xl">
          今日の歩き方を<br />選んでみる
        </h2>
        <p class="mt-5 max-w-md text-sm leading-7 text-white/65">
          滞在時間と興味に合わせて、4つのコースからおすすめを選びます。入力内容はブラウザ内だけで処理されます。
        </p>
      </div>

      <div class="p-7 sm:p-10">
        <div class="grid gap-7 sm:grid-cols-2">
          <label class="block">
            <span class="text-sm font-medium text-white">歩ける時間</span>
            <select id="route-time" class="mt-2 w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-base text-white focus:bg-moss-dark">
              <option value="30" class="text-ink">30分くらい</option>
              <option value="60" class="text-ink" selected>1時間くらい</option>
              <option value="90" class="text-ink">1時間半くらい</option>
              <option value="150" class="text-ink">半日ゆっくり</option>
            </select>
          </label>

          <fieldset>
            <legend class="text-sm font-medium text-white">重視したいこと</legend>
            <div class="mt-3 grid grid-cols-2 gap-3 text-sm">
              <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-3 py-2.5">
                <input class="size-4 accent-sakura" type="checkbox" value="写真" data-interest /> 写真
              </label>
              <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-3 py-2.5">
                <input class="size-4 accent-sakura" type="checkbox" value="歴史" data-interest /> 歴史
              </label>
              <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-3 py-2.5">
                <input class="size-4 accent-sakura" type="checkbox" value="子連れ" data-interest /> 子連れ
              </label>
              <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-3 py-2.5">
                <input class="size-4 accent-sakura" type="checkbox" value="ランチ" data-interest /> ランチ
              </label>
            </div>
          </fieldset>
        </div>

        <button id="find-route" type="button" class="mt-7 inline-flex items-center justify-center rounded-full bg-sakura-soft px-6 py-3 text-sm font-semibold text-moss-dark transition hover:bg-white">
          おすすめを表示
        </button>

        <div id="route-result" class="mt-8 hidden rounded-2xl border border-white/15 bg-white/8 p-6" aria-live="polite">
          <p class="text-xs font-semibold tracking-[0.2em] text-sakura-soft">おすすめコース</p>
          <h3 id="route-result-title" class="font-jp-serif mt-2 text-2xl tracking-wider"></h3>
          <p id="route-result-meta" class="mt-3 text-sm text-white/60"></p>
          <p id="route-result-copy" class="mt-4 text-sm leading-7 text-white/80"></p>
          <a id="route-result-link" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-sakura-soft hover:text-white" href="/course/">
            コース詳細を見る <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script id="route-data" type="application/json" set:html={JSON.stringify(routeData)} />
<script>
  type RouteItem = {
    slug: string;
    title: string;
    duration: number;
    distance: string;
    start: string;
    end: string;
    mood: string;
    tags: string[];
    suitableFor: string[];
  };

  const dataElement = document.querySelector<HTMLScriptElement>('#route-data');
  const routes: RouteItem[] = dataElement?.textContent ? JSON.parse(dataElement.textContent) : [];
  const button = document.querySelector<HTMLButtonElement>('#find-route');
  const time = document.querySelector<HTMLSelectElement>('#route-time');
  const result = document.querySelector<HTMLElement>('#route-result');
  const title = document.querySelector<HTMLElement>('#route-result-title');
  const meta = document.querySelector<HTMLElement>('#route-result-meta');
  const copy = document.querySelector<HTMLElement>('#route-result-copy');
  const link = document.querySelector<HTMLAnchorElement>('#route-result-link');

  button?.addEventListener('click', () => {
    const target = Number(time?.value ?? 60);
    const interests = Array.from(document.querySelectorAll<HTMLInputElement>('[data-interest]:checked')).map((input) => input.value);

    const scored = routes.map((route) => {
      let score = -Math.abs(route.duration - target) / 20;
      const text = `${route.tags.join(' ')} ${route.suitableFor.join(' ')} ${route.mood}`;
      for (const interest of interests) {
        if (text.includes(interest)) score += 2;
        if (interest === '写真' && route.slug === 'standard') score += 1;
        if (interest === '歴史' && route.slug === 'history') score += 2;
        if (interest === '子連れ' && route.slug === 'short') score += 2;
        if (interest === 'ランチ' && route.slug === 'half-day') score += 2;
      }
      return { route, score };
    }).sort((a, b) => b.score - a.score);

    const selected = scored[0]?.route;
    if (!selected || !result || !title || !meta || !copy || !link) return;

    title.textContent = selected.title;
    meta.textContent = `${selected.duration}分・${selected.distance}｜${selected.start} → ${selected.end}`;
    copy.textContent = selected.mood;
    link.href = `/course/#${selected.slug}`;
    result.classList.remove('hidden');
    result.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'nearest' });
  });
</script>
