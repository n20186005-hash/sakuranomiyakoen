---
import SectionHeading from '@/components/SectionHeading.astro';
import { routes } from '@/data/site';
import { useTranslations, localize } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

type Props = { lang?: Locale };
const { lang = 'ja' } = Astro.props;
const { t } = useTranslations(lang);
const labels = t('extra.routeFinder') as Record<string, any>;

const routeData = routes.map((r) => {
  const loc = localize('routes', r, lang);
  return {
    slug: r.slug,
    title: loc.title,
    start: loc.start,
    end: loc.end,
    mood: loc.mood,
    tags: loc.tags,
    suitableFor: loc.suitableFor,
    duration: r.duration,
    distance: r.distance,
    match: r.tags,
    fromSaku: r.start.includes('桜ノ宮'),
  };
});
---
<section class="mx-auto max-w-6xl px-5 py-20 lg:px-8">
  <SectionHeading eyebrow={labels.eyebrow} title={labels.title} description={labels.desc} />

  <div class="mt-10 grid gap-6 lg:grid-cols-[1fr_1.1fr]">
    <div class="rounded-3xl border border-ink/10 bg-white/65 p-7 shadow-soft">
      <div class="grid gap-6">
        <fieldset>
          <legend class="text-sm font-semibold text-ink">{labels.optionTime}</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {labels.times.map((time: string, index: number) => (
              <label class:list={['cursor-pointer rounded-full border px-4 py-2 text-sm', index === 0 ? 'border-moss bg-moss text-white' : 'border-ink/15 bg-paper text-ink']}>
                <input type="radio" name="rf-time" value={index} class="sr-only" checked={index === 0} />{time}
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend class="text-sm font-semibold text-ink">{labels.optionPeople}</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {labels.people.map((people: string, index: number) => (
              <label class="cursor-pointer rounded-full border border-ink/15 bg-paper px-4 py-2 text-sm text-ink">
                <input type="radio" name="rf-people" value={index} class="sr-only" />{people}
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend class="text-sm font-semibold text-ink">{labels.optionPurpose}</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {labels.purposes.map((purpose: string, index: number) => (
              <label class="cursor-pointer rounded-full border border-ink/15 bg-paper px-4 py-2 text-sm text-ink">
                <input type="radio" name="rf-purpose" value={index} class="sr-only" />{purpose}
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend class="text-sm font-semibold text-ink">{labels.optionMood}</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {labels.moods.map((mood: string, index: number) => (
              <label class="cursor-pointer rounded-full border border-ink/15 bg-paper px-4 py-2 text-sm text-ink">
                <input type="radio" name="rf-mood" value={index} class="sr-only" />{mood}
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend class="text-sm font-semibold text-ink">★</legend>
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            {labels.interests.map((interest: string, index: number) => (
              <label class="cursor-pointer rounded-xl border border-ink/15 bg-paper px-4 py-3 text-sm text-ink">
                <input type="checkbox" name="rf-interest" value={index} class="mr-2 align-middle" />{interest}
              </label>
            ))}
          </div>
        </fieldset>
      </div>
    </div>

    <div class="rounded-3xl border border-ink/10 bg-moss/5 p-7">
      <h2 class="font-jp-serif text-xl tracking-wider text-ink">{labels.resultTitle}</h2>
      <div id="rf-results" class="mt-5 grid gap-4"></div>
    </div>
  </div>
</section>

<script define:vars={{ routeData, labels }}>
  const radios = document.querySelectorAll('input[type="radio"][name^="rf-"]');
  const checks = document.querySelectorAll('input[name="rf-interest"]');
  const results = document.getElementById('rf-results');

  const tagKeys = ['桜', '建築', '写真', 'のんびり', '運動'];

  function value(name) {
    const el = document.querySelector(`input[name="${name}"]:checked`);
    return el ? Number(el.value) : 0;
  }

  function render() {
    const timeLevel = value('rf-time');
    const people = value('rf-people');
    const purpose = value('rf-purpose');
    const mood = value('rf-mood');
    const interests = Array.from(checks).filter((c) => c.checked).map((c) => Number(c.value));

    const matches = routeData.filter((route) => {
      const timeOk = route.duration <= [30, 60, 90][timeLevel];
      const peopleOk = people === 0 || (people === 1 && route.match.includes('一人')) || (people === 2 && route.match.includes('子連れ')) || (people === 2 && route.match.includes('ファミリー'));
      const purposeOk = purpose === 0 || (purpose === 1 && route.match.includes('写真')) || (purpose === 2 && route.match.includes('のんびり'));
      const moodOk = mood === 0 || (mood === 1 && route.match.includes('賑やか'));
      const interestOk = interests.length === 0 || interests.some((i) => route.match.includes(tagKeys[i]));
      return timeOk && peopleOk && purposeOk && moodOk && interestOk;
    });

    if (!results) return;
    if (matches.length === 0) {
      results.innerHTML = `<p class="rounded-2xl border border-ink/10 bg-white/70 p-5 text-sm text-muted">${labels.none}</p>`;
      return;
    }
    results.innerHTML = matches
      .map((route) => {
        const head = route.fromSaku ? `${labels.fromStation} <span class="font-jp-serif">${route.title}</span>` : `<span class="font-jp-serif">${route.title}</span> ${labels.toStation}`;
        const tagList = route.tags.map((tag) => `<span class="rounded-full bg-white/70 px-2.5 py-1 text-xs text-muted">${tag}</span>`).join(' ');
        return `<article class="rounded-2xl border border-ink/10 bg-white/70 p-5">
          <p class="text-xs text-muted">${labels.resultCourse}</p>
          <h3 class="mt-1 text-lg font-medium text-ink">${head}</h3>
          <p class="mt-2 text-sm text-river-deep">${route.mood}</p>
          <div class="mt-3 flex flex-wrap gap-2">${tagList}</div>
          <p class="mt-3 text-xs text-muted">${labels.matches}：<a href="#${route.slug}" class="text-river-deep underline underline-offset-2">${route.title}</a></p>
          <p class="mt-1 text-xs text-muted">${route.duration}${labels.min} ・ ${route.distance}</p>
        </article>`;
      })
      .join('');
  }

  radios.forEach((r) => r.addEventListener('change', render));
  checks.forEach((c) => c.addEventListener('change', render));
  render();
</script>
