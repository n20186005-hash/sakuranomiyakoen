---
import SectionHeading from '@/components/SectionHeading.astro';
import { dataI18n } from '@/i18n/data';
import { useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

type Props = { lang?: Locale };
const { lang = 'ja' } = Astro.props;
const { t } = useTranslations(lang);

const baseSources = [
  { title: '国土交通省 近畿地方整備局 淀川河川国道事務所', body: '大川・毛馬桜之宮公園の整備・管理に関する情報。桜並木や河川敷の管理方針を確認できます。' },
  { title: '大阪市 毛馬桜之宮公園', body: '公園の基本情報（開園時間・施設・イベント）を公式に発信しています。' },
  { title: '気象庁 大阪の気象情報', body: '開花予想や天候・河川の水位情報の参考に。' },
  { title: 'Osaka Metro / JR西日本', body: '駅・アクセス・運行状況の公式情報。' },
];
const sources = lang === 'ja' ? baseSources : (dataI18n[lang]?.sources ?? baseSources);
const credits = lang === 'ja'
  ? { title: '写真提供', license: '一部クリエイティブ・コモンズ等の写真を利用' }
  : (dataI18n[lang]?.photoCredits ?? { title: '写真提供', license: '一部クリエイティブ・コモンズ等の写真を利用' });
---
<section class="mx-auto max-w-5xl px-5 py-20 lg:px-8">
  <SectionHeading eyebrow={t('extra.sourcesEyebrow')} title={t('extra.sourcesTitle')} description={t('extra.sourcesDesc')} />

  <div class="mt-12 grid gap-5 sm:grid-cols-2">
    {
      sources.map((source: { title: string; body: string }) => (
        <article class="rounded-3xl border border-ink/10 bg-white/65 p-7 shadow-soft">
          <h2 class="font-jp-serif text-lg tracking-wider text-ink">{source.title}</h2>
          <p class="mt-3 text-sm leading-7 text-muted">{source.body}</p>
        </article>
      ))
    }
  </div>

  <p class="mt-8 text-sm leading-7 text-muted">
    <span class="font-semibold text-ink">{credits.title}：</span>{credits.license}
  </p>
</section>
