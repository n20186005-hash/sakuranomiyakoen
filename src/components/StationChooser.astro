---
import { useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

type Props = { lang?: Locale };
const { lang = 'ja' } = Astro.props;
const { t } = useTranslations(lang);
const buttons = t('comp.stationChooser.buttons') as [string, string, string][];
const info = t('comp.stationChooser.info') as Record<string, { label: string; name: string; copy: string; href: string }>;
const defaultKey = 'sakuranomiya';
---
<section class="mx-auto max-w-7xl px-5 py-20 lg:px-8" aria-labelledby="station-title">
  <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:items-start">
    <div>
      <p class="text-xs font-semibold tracking-[0.25em] text-moss">{t('comp.stationChooser.eyebrow')}</p>
      <h2 id="station-title" class="font-jp-serif mt-4 text-3xl leading-snug tracking-wider sm:text-4xl">{t('comp.stationChooser.title')}</h2>
      <p class="mt-5 text-base leading-8 text-muted">{t('comp.stationChooser.lead')}</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
      {buttons.map(([line, name, desc], index) => (
        <button
          type="button"
          class:list={[
            'station-button rounded-3xl border border-ink/10 bg-white/65 p-6 text-left shadow-soft transition hover:-translate-y-1 hover:bg-white',
            index === 0 && 'ring-2 ring-sakura',
          ]}
          data-station={index === 0 ? 'sakuranomiya' : index === 1 ? 'osakajo' : 'temmabashi'}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          <span class="text-xs font-semibold tracking-[0.18em] text-river-deep">{line}</span>
          <span class="font-jp-serif mt-3 block text-2xl tracking-wider">{name}</span>
          <span class="mt-3 block text-sm leading-6 text-muted">{desc}</span>
        </button>
      ))}
    </div>
  </div>

  <div id="station-result" class="mt-8 rounded-3xl border border-river/20 bg-river/8 p-6 sm:p-8" aria-live="polite">
    <div class="grid gap-6 sm:grid-cols-[1fr_auto] sm:items-center">
      <div>
        <p id="station-label" class="text-xs font-semibold tracking-[0.2em] text-river-deep">{info[defaultKey].label}</p>
        <h3 id="station-name" class="font-jp-serif mt-2 text-2xl tracking-wider text-ink">{info[defaultKey].name}</h3>
        <p id="station-copy" class="mt-3 max-w-3xl text-sm leading-7 text-muted">{info[defaultKey].copy}</p>
      </div>
      <a id="station-link" href={info[defaultKey].href} class="inline-flex items-center justify-center rounded-full bg-moss px-6 py-3 text-sm font-semibold text-white hover:bg-moss-dark">おすすめコース</a>
    </div>
  </div>
</section>

<script define:vars={{ info }}>
  const stationInfo = info;
  const buttons = document.querySelectorAll<HTMLButtonElement>('.station-button');
  const label = document.querySelector<HTMLElement>('#station-label');
  const name = document.querySelector<HTMLElement>('#station-name');
  const copy = document.querySelector<HTMLElement>('#station-copy');
  const link = document.querySelector<HTMLAnchorElement>('#station-link');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.dataset.station;
      const data = key ? stationInfo[key] : undefined;
      if (!data || !label || !name || !copy || !link) return;
      buttons.forEach((item) => {
        const active = item === button;
        item.setAttribute('aria-pressed', String(active));
        item.classList.toggle('ring-2', active);
        item.classList.toggle('ring-sakura', active);
      });
      label.textContent = data.label;
      name.textContent = data.name;
      copy.textContent = data.copy;
      link.href = data.href;
    });
  });
</script>
