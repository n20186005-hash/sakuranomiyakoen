---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Notice from '@/components/Notice.astro';
import { useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

type Props = { lang?: Locale };
const { lang = 'ja' } = Astro.props;
const { t } = useTranslations(lang);
const phases = t('sakura.phases') as [string, string, string][];
const timeCards = t('sakura.timeCards') as [string, string, string, string][];
const views = t('sakura.views') as [string, string][];
const manners = t('sakura.manners') as [string, string][];
const guideSections = t('sakura.guideSections') as [string, string][];
---
<BaseLayout lang={lang} title={t('sakura.title')} description={t('sakura.desc')}>
  <Breadcrumbs items={[{ label: t('common.home'), href: '/' }, { label: t('sakura.crumb') }]} />
  <PageHero
    eyebrow={t('sakura.heroEyebrow')}
    title={t('sakura.heroTitle')}
    description={t('sakura.heroDesc')}
    image="/images/boats.webp"
    imageSmall="/images/boats-900.webp"
    imageAlt={t('sakura.heroTitle')}
  />

  <section class="mx-auto max-w-7xl px-5 py-12 lg:px-8">
    <div class="grid gap-6 sm:grid-cols-4">
      {phases.map(([date, state, copy], index) => (
        <article class="relative rounded-3xl border border-ink/10 bg-white/65 p-6 shadow-soft">
          <span class="font-jp-serif text-2xl text-sakura/80">{String(index + 1).padStart(2, '0')}</span>
          <p class="mt-4 text-xs font-semibold tracking-[0.16em] text-muted">{date}</p>
          <h2 class="font-jp-serif mt-2 text-2xl tracking-wider">{state}</h2>
          <p class="mt-3 text-sm leading-7 text-muted">{copy}</p>
        </article>
      ))}
    </div>
    <p class="mt-5 text-xs leading-6 text-muted">{t('sakura.phasesNote')}</p>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <SectionHeading eyebrow={t('sakura.timeEyebrow')} title={t('sakura.timeTitle')} description={t('sakura.timeDesc')} />
    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {timeCards.map(([time, title, copy, who]) => (
        <article class="rounded-3xl border border-ink/10 bg-white/65 p-7 shadow-soft">
          <p class="text-xs font-semibold tracking-[0.2em] text-river-deep">{time}</p>
          <h2 class="font-jp-serif mt-3 text-2xl tracking-wider">{title}</h2>
          <p class="mt-4 text-sm leading-7 text-muted">{copy}</p>
          <p class="mt-5 text-xs text-muted">{who}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-12 px-5 py-20 lg:grid-cols-2 lg:items-center lg:px-8">
    <figure class="photo-frame aspect-[4/3] shadow-soft">
      <img src="/images/bridge.webp" srcset="/images/bridge-900.webp 900w, /images/bridge.webp 1600w" sizes="(min-width:1024px) 50vw, 100vw" width="1600" height="900" alt="源八橋周辺の大川と桜並木" loading="lazy" />
    </figure>
    <div>
      <SectionHeading eyebrow={t('sakura.viewsEyebrow')} title={t('sakura.viewsTitle')} />
      <div class="mt-8 grid gap-6">
        {views.map(([title, copy]) => (
          <div class="border-l-2 border-sakura pl-5">
            <h2 class="font-jp-serif text-xl tracking-wider">{title}</h2>
            <p class="mt-2 text-sm leading-7 text-muted">{copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-20 lg:px-8">
    <SectionHeading eyebrow={t('sakura.mannersEyebrow')} title={t('sakura.mannersTitle')} align="center" />
    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {manners.map(([title, copy]) => (
        <article class="rounded-2xl border border-ink/10 bg-white/65 p-6">
          <h2 class="font-jp-serif text-xl tracking-wider">{title}</h2>
          <p class="mt-3 text-sm leading-7 text-muted">{copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <Notice title={t('sakura.noticeTitle')} tone="sakura">
      <p>{t('sakura.noticeBody')}</p>
      <a href="/course/#short" class="mt-3 inline-flex font-semibold text-river-deep">{t('common.viewCourse')} →</a>
    </Notice>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <SectionHeading eyebrow={t('sakura.guideEyebrow')} title={t('sakura.guideTitle')} description={t('sakura.guideDesc')} />
    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      {guideSections.map(([title, copy], index) => (
        <article class="rounded-3xl border border-ink/10 bg-white/65 p-7 shadow-soft">
          <p class="font-jp-serif text-2xl text-sakura/80">{String(index + 1).padStart(2, '0')}</p>
          <h2 class="font-jp-serif mt-2 text-2xl tracking-wider">{title}</h2>
          <p class="mt-3 text-sm leading-7 text-muted">{copy}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
