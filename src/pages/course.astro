---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PageHero from '@/components/PageHero.astro';
import RouteCard from '@/components/RouteCard.astro';
import ParkSchematic from '@/components/ParkSchematic.astro';
import Notice from '@/components/Notice.astro';
import { routes } from '@/data/site';
---
<BaseLayout
  title="時間別の散歩コース"
  description="毛馬桜之宮公園を30分、60分、90分、半日で歩く4つのコース。出発駅、到着駅、距離、立ち寄り場所を紹介します。"
>
  <Breadcrumbs items={[{ label: 'ホーム', href: '/' }, { label: '散歩コース' }]} />
  <PageHero
    eyebrow="WALKING COURSES"
    title="使える時間から、今日の散歩を選ぶ。"
    description="公園全体を一度に歩く必要はありません。駅に戻る短いコースから、天満橋まで進む半日コースまで、目的に合わせて選べます。"
    image="/images/bridge.webp"
    imageSmall="/images/bridge-900.webp"
    imageAlt="源八橋と大川に沿って続く桜並木"
  />

  <section class="mx-auto max-w-7xl px-5 py-10 lg:px-8">
    <ParkSchematic />
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <div class="grid gap-10">
      {routes.map((route, index) => <RouteCard route={route} featured={index === 2} />)}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <div class="grid gap-5 lg:grid-cols-3">
      <Notice title="雨の日" tone="river">
        <p>河岸は風を受けやすく、路面が滑ることがあります。短いコースに変更し、美術館や駅周辺の食事と組み合わせましょう。</p>
      </Notice>
      <Notice title="夏の日" tone="moss">
        <p>日陰が途切れる区間があります。朝夕を選び、水分を携帯し、桜ノ宮ビーチ周辺でも現地の水辺ルールに従ってください。</p>
      </Notice>
      <Notice title="桜の週末" tone="sakura">
        <p>駅、橋、人気の河岸は混雑します。待ち合わせ場所を駅改札だけにせず、具体的な橋や施設まで決めておくと安心です。</p>
      </Notice>
    </div>
  </section>
</BaseLayout>
