---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { faq } from '@/data/site';
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---
<BaseLayout
  title="よくある質問"
  description="毛馬桜之宮公園の料金、開園時間、桜の見頃、最寄り駅、駐車場、バーベキュー、ベビーカー、トイレ、飲食について回答します。"
  jsonLd={faqSchema}
>
  <Breadcrumbs items={[{ label: 'ホーム', href: '/' }, { label: 'よくある質問' }]} />
  <PageHero
    eyebrow="FREQUENTLY ASKED QUESTIONS"
    title="出かける前の、小さな疑問を解決。"
    description="料金、時間、駅、花見、食事。初めて歩く人が迷いやすいポイントをまとめました。"
    image="/images/waterfront.webp"
    imageSmall="/images/waterfront-900.webp"
    imageAlt="春の毛馬桜之宮公園と大川"
  />

  <section class="mx-auto max-w-5xl px-5 py-20 lg:px-8">
    <SectionHeading eyebrow="Q & A" title="よくある質問" align="center" />
    <div class="mt-12 grid gap-4">
      {faq.map((item, index) => (
        <details class="group rounded-2xl border border-ink/10 bg-white/65 p-5 shadow-sm open:bg-white sm:p-7" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-5">
            <span class="flex items-start gap-4">
              <span class="font-jp-serif text-lg text-sakura">Q{String(index + 1).padStart(2, '0')}</span>
              <span class="font-medium leading-7 text-ink">{item.question}</span>
            </span>
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-paper text-lg transition group-open:rotate-45" aria-hidden="true">＋</span>
          </summary>
          <div class="mt-5 border-t border-ink/10 pt-5 sm:ml-12">
            <p class="text-sm leading-8 text-muted">{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
