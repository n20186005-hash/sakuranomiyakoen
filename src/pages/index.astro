---
import BaseLayout from '@/layouts/BaseLayout.astro';
import QuickFacts from '@/components/QuickFacts.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import RouteFinder from '@/components/RouteFinder.astro';
import StationChooser from '@/components/StationChooser.astro';
import ParkSchematic from '@/components/ParkSchematic.astro';
import AttractionCard from '@/components/AttractionCard.astro';
import RestaurantCard from '@/components/RestaurantCard.astro';
import Notice from '@/components/Notice.astro';
import { attractions, faq, restaurants, site } from '@/data/site';

const touristAttraction = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: '毛馬桜之宮公園',
  alternateName: ['桜之宮公園', '桜ノ宮公園', 'Kema Sakuranomiya Park'],
  description: site.description,
  url: site.url,
  image: `${site.url}/images/og.jpg`,
  isAccessibleForFree: true,
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.coordinates.lat,
    longitude: site.coordinates.lng,
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: '大阪市',
    addressRegion: '大阪府',
    addressCountry: 'JP',
  },
  publicAccess: true,
  openingHours: 'Mo-Su 00:00-24:00',
};
---
<BaseLayout jsonLd={touristAttraction}>
  <section class="relative isolate min-h-[78svh] overflow-hidden bg-moss-dark text-white">
    <picture class="absolute inset-0 -z-20">
      <source media="(max-width: 900px)" srcset="/images/hero-900.webp" type="image/webp" />
      <img src="/images/hero.webp" width="1920" height="1200" alt="大川の両岸に桜並木が続く毛馬桜之宮公園" class="size-full object-cover" fetchpriority="high" />
    </picture>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-moss-dark/90 via-moss-dark/62 to-moss-dark/20"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-moss-dark/65 via-transparent to-transparent"></div>

    <div class="mx-auto flex min-h-[78svh] max-w-7xl items-end px-5 pb-14 pt-28 lg:px-8 lg:pb-20">
      <div class="max-w-3xl reveal">
        <div class="mb-6 inline-flex items-center gap-3 rounded-full border border-white/25 bg-white/10 px-4 py-2 text-xs tracking-[0.18em] backdrop-blur">
          <span class="sakura-mark text-sakura-soft" aria-hidden="true"></span>
          大阪・大川沿いの散歩案内
        </div>
        <p class="text-sm font-medium tracking-[0.28em] text-white/70">KEMA SAKURANOMIYA PARK</p>
        <h1 class="font-jp-serif mt-4 text-balance text-5xl leading-[1.2] tracking-[0.08em] sm:text-6xl lg:text-7xl">
          桜と水辺を、<br />ゆっくり歩く。
        </h1>
        <p class="mt-7 max-w-2xl text-pretty text-base leading-8 text-white/78 sm:text-lg">
          約4.2km続く大川の河岸公園。桜ノ宮駅からの入口、時間別コース、歴史建築、周辺ランチまで、今日の歩き方を一つにまとめました。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/course/" class="inline-flex items-center justify-center rounded-full bg-sakura-soft px-6 py-3.5 text-sm font-semibold text-moss-dark transition hover:bg-white">
            散歩コースを見る
          </a>
          <a href="/access/" class="inline-flex items-center justify-center rounded-full border border-white/35 bg-white/8 px-6 py-3.5 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/15">
            駅から選ぶ
          </a>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 right-5 hidden items-center gap-3 text-xs tracking-[0.2em] text-white/55 lg:flex lg:right-8">
      <span class="h-px w-16 bg-white/35"></span> SCROLL TO WALK
    </div>
  </section>

  <div class="relative z-10 -mt-4 rounded-t-[2rem] bg-paper pt-12 sm:-mt-8 sm:rounded-t-[3rem]">
    <QuickFacts />

    <section class="mx-auto grid max-w-7xl gap-12 px-5 py-24 lg:grid-cols-[0.75fr_1.25fr] lg:items-center lg:px-8">
      <div>
        <SectionHeading
          eyebrow="ABOUT THE PARK"
          title="ひとつの場所ではなく、川沿いに続く散歩道。"
          description="毛馬桜之宮公園は、大川の両岸に細長く広がります。どの駅から入り、どこまで歩くかで体験が変わる公園です。"
        />
        <div class="mt-8 grid gap-5 text-sm leading-7 text-muted">
          <p>短時間なら桜ノ宮駅と源八橋周辺。建築や庭園まで見るなら大阪城北詰駅へ。造幣局や天満橋まで伸ばせば、半日の水辺散歩になります。</p>
          <a href="/nearby/" class="inline-flex w-fit items-center gap-2 font-semibold text-river-deep hover:text-moss">見どころを詳しく見る <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <ParkSchematic compact={true} />
    </section>

    <RouteFinder />

    <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
      <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading
          eyebrow="PLACES ALONG THE RIVER"
          title="歩く途中に出会う場所"
          description="春の桜だけでなく、水辺、近代建築、庭園、美術館が一本の散歩道につながっています。"
        />
        <a href="/nearby/" class="shrink-0 text-sm font-semibold text-river-deep hover:text-moss">すべての見どころ →</a>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {attractions.slice(0, 3).map((attraction, index) => <AttractionCard attraction={attraction} index={index} />)}
      </div>
    </section>

    <StationChooser />

    <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
      <div class="overflow-hidden rounded-[2rem] bg-paper-2">
        <div class="grid lg:grid-cols-2">
          <figure class="photo-frame min-h-[360px] rounded-none lg:min-h-[520px]">
            <img src="/images/boats.webp" srcset="/images/boats-900.webp 900w, /images/boats.webp 1400w" sizes="(min-width: 1024px) 50vw, 100vw" width="1400" height="933" alt="桜が続く大川を行き交う船" loading="lazy" />
          </figure>
          <div class="paper-noise flex items-center p-8 sm:p-12 lg:p-16">
            <div>
              <p class="text-xs font-semibold tracking-[0.25em] text-moss">SAKURA SEASON</p>
              <h2 class="font-jp-serif mt-5 text-balance text-3xl leading-snug tracking-wider sm:text-4xl">桜の見頃は、例年3月下旬から4月上旬。</h2>
              <p class="mt-6 text-base leading-8 text-muted">開花は年ごとに変わります。満開の休日は混雑しやすいため、静かに歩くなら平日の朝。橋の上からは、桜並木と大川を一緒に見渡せます。</p>
              <div class="mt-7 flex flex-wrap gap-3">
                <a href="/sakura/" class="rounded-full bg-moss px-6 py-3 text-sm font-semibold text-white hover:bg-moss-dark">桜の歩き方</a>
                <a href="/photo/" class="rounded-full border border-ink/15 bg-white/60 px-6 py-3 text-sm font-semibold text-ink hover:bg-white">写真の時間帯</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
      <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading
          eyebrow="LUNCH AFTER THE WALK"
          title="散歩の前後に、桜ノ宮で食べる。"
          description="園内に常設の飲食店はありません。駅周辺の町中華やラーメン、歴史建築のレストランを目的別に選べます。"
        />
        <a href="/gourmet/" class="shrink-0 text-sm font-semibold text-river-deep hover:text-moss">周辺ランチをすべて見る →</a>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {restaurants.slice(0, 3).map((restaurant, index) => <RestaurantCard restaurant={restaurant} index={index} />)}
      </div>
      <p class="mt-6 text-xs leading-6 text-muted">営業時間・定休日は変更される場合があります。訪問当日に店舗の最新案内をご確認ください。</p>
    </section>

    <section class="mx-auto max-w-5xl px-5 py-20 lg:px-8">
      <SectionHeading eyebrow="BEFORE YOU GO" title="出かける前に知っておきたいこと" align="center" />
      <div class="mt-12 grid gap-4">
        {faq.slice(0, 4).map((item) => (
          <details class="group rounded-2xl border border-ink/10 bg-white/65 p-5 open:bg-white sm:p-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-ink">
              {item.question}
              <span class="grid size-8 shrink-0 place-items-center rounded-full bg-paper text-lg transition group-open:rotate-45" aria-hidden="true">＋</span>
            </summary>
            <p class="mt-4 max-w-3xl text-sm leading-7 text-muted">{item.answer}</p>
          </details>
        ))}
      </div>
      <div class="mt-8 text-center"><a href="/faq/" class="text-sm font-semibold text-river-deep hover:text-moss">よくある質問をすべて見る →</a></div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
      <Notice title="このサイトについて" tone="moss">
        <p>毛馬桜之宮公園を歩くための非公式ガイドです。施設の開館、イベント、桜の開花状況は変わるため、当日の現地掲示や各施設の最新情報も確認してください。</p>
      </Notice>
    </section>
  </div>
</BaseLayout>
