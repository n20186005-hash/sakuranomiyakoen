  sakura: [
    { q: '桜並木を短時間で歩くなら？', a: 'JR桜ノ宮駅から源八橋付近まで歩き、両岸の桜を見渡して駅へ戻るルートが便利です。' },
    { q: '桜の撮影に向く場所は？', a: '源八橋からの俯瞰と川沿いの遊歩道では構図が異なります。朝は水面の反射、夕方は橋のシルエットを比較できます。' },
  ],
  beach: [
    { q: '桜ノ宮ビーチで泳げますか？', a: '砂浜があっても遊泳可能とは限りません。水辺の利用範囲やイベントの条件は現地掲示で必ず確認してください。' },
    { q: '雨の翌日も歩けますか？', a: '河川の増水やぬかるみの影響があります。安全な園路から様子を確かめ、水際に無理に近づかないでください。' },
  ],
  hall: [
    { q: '旧桜宮公会堂は自由に入れますか？', a: '現在は婚礼や催事に利用される施設です。外観の鑑賞と館内利用は別で、入館や食事には営業・貸切状況の確認が必要です。' },
    { q: 'どの部分が歴史的に重要ですか？', a: '保存・移築された石造の正面玄関が重要文化財です。建物全体が同じ明治期に建てられたわけではない点にも注目してください。' },
  ],
  sempukan: [
    { q: '泉布観の内部を見学できますか？', a: '大阪市は耐震性能の確認に伴い一般公開を当面休止すると案内しています。訪問前に公式ページで再開の有無をご確認ください。' },
    { q: '泉布観と公会堂は同じ建物ですか？', a: '別の建物です。泉布観は造幣寮の応接所、隣の旧桜宮公会堂では移築された旧鋳造所の石造玄関が見どころです。' },
  ],
  'fujita-garden': [
    { q: '庭園と河川敷の公園は同じ時間に入れますか？', a: '庭園の開放時間は自由に歩ける大川の遊歩道と異なる場合があります。大阪市の情報と現地掲示を確認してください。' },
    { q: '日本庭園では何を見ればよいですか？', a: 'かつての庭園の築山、石組み、池と園路の曲がり方が見どころです。藤田美術館と合わせると旧邸宅の背景も分かります。' },
  ],
  museum: [
    { q: '藤田美術館の展示はいつも同じですか？', a: '展示替えや休館日があります。目的の作品がある方は美術館の公式展覧会・カレンダーを確認してください。' },
    { q: '周辺散歩と合わせるなら？', a: 'JR大阪城北詰駅から美術館を訪れ、隣接する藤田邸跡公園を散策して大川沿いへ抜ける順路が考えられます。' },
  ],
  'mint-museum': [
    { q: '桜の通り抜けと博物館は同じ入場方法ですか？', a: '季節行事と通常の博物館見学は入口や入場条件が異なる場合があります。造幣局の当日案内を確認してください。' },
    { q: '貨幣以外の見どころは？', a: '歴史的な赤煉瓦の建築と近代産業の展示も注目点です。近くの泉布観や旧桜宮公会堂と関連づけて歩けます。' },
  ],
  'genpachi-bridge': [
    { q: '橋から桜を撮るときの注意は？', a: '車道へ出ず、歩行者の通行を妨げない場所で短時間に撮影してください。橋からは大川の上流・下流を見比べられます。' },
    { q: '橋を渡った後はどこへ？', a: '河岸の遊歩道へ下りて桜並木や桜ノ宮ビーチ方面へ続けると、橋上からとは違う水辺の景色を楽しめます。' },
  ],
};

export function getStaticPaths() {
  return ['sakura', 'beach', 'hall', 'sempukan', 'fujita-garden', 'museum', 'mint-museum', 'genpachi-bridge'].map((slug) => ({ params: { slug }, props: { attraction: attractions.find((a) => a.slug === slug)! } }));
}

const { attraction } = Astro.props as { attraction: (typeof attractions)[number] };
const info = guide[attraction.slug];
const detail = depth[attraction.slug];
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(info.mapQuery)}`;
const related = attractions.filter((a) => a.slug !== attraction.slug).slice(0, 3);
const description = `${attraction.name}の見どころ、背景、アクセス、散歩ルート、撮影ポイントと訪問前の注意点。毛馬桜之宮公園周辺を歩くための個別ガイド。`;
const schema = { '@context': 'https://schema.org', '@type': 'TouristAttraction', name: attraction.name, description, address: { '@type': 'PostalAddress', streetAddress: info.address, addressLocality: '大阪市', addressRegion: '大阪府', addressCountry: 'JP' }, url: `https://sakuranomiyakoen.com/nearby/${attraction.slug}/`, hasMap: mapUrl };
---
<BaseLayout title={`${attraction.name}｜見どころ・アクセス・散歩ガイド`} description={description} image={attraction.image} jsonLd={schema}>
  <Breadcrumbs items={[{ label: 'ホーム', href: '/' }, { label: '周辺の見どころ', href: '/nearby/' }, { label: attraction.name }]} />
  <PageHero eyebrow={attraction.eyebrow} title={attraction.name} description={attraction.summary} image={attraction.image} imageAlt={attraction.imageAlt} />
  <main class="mx-auto max-w-5xl space-y-14 px-5 py-14 lg:px-8">
    <section class="rounded-3xl bg-white/70 p-7 shadow-soft sm:p-10">
      <p class="text-sm font-semibold tracking-widest text-moss">EXPLORE</p>
      <h2 class="font-jp-serif mt-3 text-3xl">この場所を歩く</h2>
      <p class="mt-5 leading-8 text-ink/80">{info.background}</p>
      <h3 class="mt-8 text-xl font-semibold">訪問のヒント</h3>
      <p class="mt-3 leading-8 text-muted">{detail.visit}</p>
      <h3 class="mt-8 text-xl font-semibold">景観と文化の特徴</h3>
      <p class="mt-3 leading-8 text-muted">{detail.design}</p>
    </section>
    <section>
      <p class="text-sm font-semibold tracking-widest text-moss">ABOUT & MANAGEMENT</p>
      <h2 class="font-jp-serif mt-3 text-3xl">この場所について・管理主体</h2>
      <p class="mt-4 leading-8">{info.management}</p>
      <p class="mt-4 leading-8 text-muted">{detail.history}</p>
      <a class="mt-4 inline-block text-moss underline underline-offset-4" href={info.official} target="_blank" rel="noopener noreferrer">管理・施設情報の確認先 ↗</a>
    </section>
    <section>
      <h2 class="font-jp-serif text-3xl">基本情報</h2>
      <dl class="mt-6 grid gap-4 rounded-3xl border border-ink/10 bg-white/65 p-7 sm:grid-cols-2">
        <div><dt class="text-sm text-muted">所在地</dt><dd class="mt-1 font-semibold">{info.address}</dd></div>
        <div><dt class="text-sm text-muted">最寄り駅</dt><dd class="mt-1 font-semibold">{attraction.nearest}</dd></div>
        <div><dt class="text-sm text-muted">見学の目安</dt><dd class="mt-1 font-semibold">{attraction.time}（移動時間別）</dd></div>
        <div><dt class="text-sm text-muted">公開状況</dt><dd class="mt-1">{detail.hours}</dd></div>
        <div><dt class="text-sm text-muted">入場料金</dt><dd class="mt-1">{detail.price}</dd></div>
        <div><dt class="text-sm text-muted">滞在プラン</dt><dd class="mt-1">{detail.stay}</dd></div>
      </dl>
    </section>
    <section>
      <h2 class="font-jp-serif text-3xl">アクセスと地図</h2>
      <p class="mt-4 leading-8">{info.access}</p>
      <a class="mt-6 inline-flex rounded-full bg-moss px-6 py-3 font-semibold text-white" href={mapUrl} target="_blank" rel="noopener noreferrer">{attraction.name}を Google マップで探す ↗</a>
      <p class="mt-3 text-sm text-muted">各スポット名で検索する地図リンクです。訪問前に正確な入口・経路を確認してください。</p>
    </section>
    <section>
      <h2 class="font-jp-serif text-3xl">歴史・景観の観察ポイント</h2>
      <p class="mt-4 leading-8 text-muted">{detail.history}</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-3">{info.focus.map((item, i) => <li class="rounded-2xl border border-ink/10 bg-white/65 p-5"><span class="text-sm font-semibold text-moss">0{i + 1}</span><p class="mt-3 leading-7">{item}</p></li>)}</ul>
    </section>
    <section>
      <h2 class="font-jp-serif text-3xl">おすすめ散歩ルート</h2>
      <ol class="mt-6 space-y-4">{info.route.map((step, i) => <li class="flex items-start gap-4 rounded-2xl bg-white/65 p-5"><span class="font-jp-serif text-2xl text-moss">{i + 1}</span><span class="pt-1 leading-7">{step}</span></li>)}</ol>
    </section>
    <section>
      <h2 class="font-jp-serif text-3xl">写真の撮り方と訪問前の注意</h2>
      <p class="mt-4 leading-8">{info.photo}</p>
      <p class="mt-4 leading-8 text-muted">開放・イベント・施設営業の状況は変わります。公園と施設で利用条件が異なるため、当日の公式案内と現地掲示を確認してください。</p>
    </section>
    <section>
      <h2 class="font-jp-serif text-3xl">周辺に泊まってゆっくり歩く</h2>
      <p class="mt-4 leading-8 text-muted">{detail.stay} 宿泊を伴う場合は大阪駅・京橋駅・天満橋駅周辺など、翌日の移動先に合う鉄道駅を起点に検討すると便利です。</p>
    </section>
    <section>
      <h2 class="font-jp-serif text-3xl">訪問者の評価を調べる</h2>
      <p class="mt-4 leading-8 text-muted">施設・景観の感じ方は季節や訪問時間によって変わります。現在の評価や個別の口コミは、この地点の Google マップ検索結果からご確認ください。ここでは未確認の点数・口コミ数を掲載していません。</p>
      <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block text-moss underline underline-offset-4">Google マップで口コミを見る ↗</a>
    </section>
    <section>
      <h2 class="font-jp-serif text-3xl">よくある質問</h2>
      <div class="mt-6 space-y-5">{specificFaq[attraction.slug].map(({ q, a }) => <div><h3 class="font-semibold">{q}</h3><p class="mt-2 leading-7 text-muted">{a}</p></div>)}<div><h3 class="font-semibold">どの駅から行くと便利ですか？</h3><p class="mt-2 text-muted">{info.access}</p></div></div>
    </section>
    <section>
      <h2 class="font-jp-serif text-3xl">近くの見どころ</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-3">{related.map((a) => <a class="overflow-hidden rounded-2xl border border-ink/10 bg-white/65 transition hover:shadow-soft" href={`/nearby/${a.slug}/`}><img src={a.image} alt={a.imageAlt} loading="lazy" class="aspect-[16/10] w-full object-cover" /><div class="p-5"><h3 class="font-semibold">{a.name}</h3><p class="mt-2 text-sm text-muted">{a.summary}</p></div></a>)}</div>
    </section>
  </main>
</BaseLayout>
