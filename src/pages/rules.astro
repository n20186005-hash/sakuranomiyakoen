---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Notice from '@/components/Notice.astro';
---
<BaseLayout
  title="公園の利用ルールと注意事項"
  description="毛馬桜之宮公園のバーベキュー・火気、ごみ、花見、撮影、自転車、水辺、犬の散歩、夜間利用に関する注意事項をまとめています。"
>
  <Breadcrumbs items={[{ label: 'ホーム', href: '/' }, { label: '公園のルール' }]} />
  <PageHero
    eyebrow="PARK MANNERS"
    title="川辺の時間を、次の人へ気持ちよく渡す。"
    description="公園は24時間自由に歩ける公共空間です。火気、ごみ、通路、水辺、撮影など、出かける前に基本のルールを確認しましょう。"
    image="/images/beach.webp"
    imageSmall="/images/beach-900.webp"
    imageAlt="桜ノ宮ビーチと大川の水辺"
  />

  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {[
        ['火気・バーベキュー', '禁止', '公園内にバーベキュー可能な指定区域はありません。コンロ、焚き火、花火など危険を伴う火気は使えません。'],
        ['ごみ', '持ち帰る', '飲食物の容器、シート、たばこなどは放置せず、持ち帰りを基本にしてください。'],
        ['場所取り', '通路を残す', 'シートや荷物で園路、自転車動線、施設入口、避難経路をふさがないようにします。'],
        ['桜・植物', '触れすぎない', '枝を引く、折る、木にロープを掛ける、根元を踏み固める行為は避けます。'],
        ['自転車', '歩行者優先', '混雑区間では速度を落とし、必要に応じて自転車を降ります。駐輪は指定や現地掲示に従います。'],
        ['水辺', '増水に注意', '川やビーチ周辺では天候と水位を確認し、立入制限、遊泳・利用案内に従ってください。'],
        ['犬の散歩', 'リードを使用', '周囲に配慮し、排泄物を処理します。人が多い花見時期はリードを短く保ちます。'],
        ['撮影', '通行を妨げない', '三脚、照明、大人数の撮影で通路を占有しないようにします。施設内は個別の撮影規則を確認します。'],
        ['夜間', '静かに歩く', '住宅に近い区間があります。大声、音楽、長時間の滞留を避け、照明が少ない場所では足元に注意します。'],
      ].map(([title, label, copy], index) => (
        <article class="rounded-3xl border border-ink/10 bg-white/65 p-7 shadow-soft">
          <div class="flex items-center justify-between gap-4">
            <span class="rounded-full bg-sakura-soft px-3 py-1 text-xs font-semibold text-moss-dark">{label}</span>
            <span class="font-jp-serif text-xl text-sakura/70">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <h2 class="font-jp-serif mt-5 text-2xl tracking-wider">{title}</h2>
          <p class="mt-4 text-sm leading-7 text-muted">{copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-20 lg:px-8">
    <SectionHeading eyebrow="IN AN EMERGENCY" title="天候と体調を優先する" align="center" />
    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      <Notice title="強風・大雨・増水" tone="river">
        <p>河岸と橋は風を受けやすい場所です。警報、立入規制、増水がある場合は水辺から離れ、散歩を中止してください。</p>
      </Notice>
      <Notice title="暑さ・日差し" tone="moss">
        <p>日陰が途切れる区間があります。水分、帽子、休憩を確保し、体調が悪いときは最寄り駅や屋内施設へ移動します。</p>
      </Notice>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <Notice title="現地掲示が最優先です" tone="sakura">
      <p>イベント、工事、災害、季節管理により、一時的な利用制限が設けられる場合があります。このページと現地掲示が異なる場合は、現地の案内に従ってください。</p>
    </Notice>
  </section>
</BaseLayout>
