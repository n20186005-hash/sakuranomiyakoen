---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Notice from '@/components/Notice.astro';
---
<BaseLayout
  title="桜の見頃と花見の歩き方"
  description="毛馬桜之宮公園の桜の見頃、混雑を避ける時間帯、橋からの眺め、花見のルール、桜ノ宮駅からの歩き方を紹介します。"
>
  <Breadcrumbs items={[{ label: 'ホーム', href: '/' }, { label: '桜の見頃' }]} />
  <PageHero
    eyebrow="SAKURA SEASON"
    title="川面に沿って続く、春の桜回廊。"
    description="大川両岸に約4,800本の桜が連なります。見頃の目安、歩く時間帯、混雑を避けるコツを知って、無理のない花見散歩へ。"
    image="/images/boats.webp"
    imageSmall="/images/boats-900.webp"
    imageAlt="大川を行き交う船と両岸に続く桜"
  />

  <section class="mx-auto max-w-7xl px-5 py-12 lg:px-8">
    <div class="grid gap-6 sm:grid-cols-4">
      {[
        ['2月〜3月中旬', 'つぼみ', '開花予想を確認しながら、散歩計画を立てる時期。'],
        ['3月下旬', '咲き始め', '年により前後。早咲きと染井吉野の差もあります。'],
        ['3月末〜4月上旬', '見頃の目安', '満開前後の週末は特に混雑しやすい時期。'],
        ['4月上旬以降', '桜吹雪', '花びらが水面や園路に舞う、静かな余韻の季節。'],
      ].map(([date, state, copy], index) => (
        <article class="relative rounded-3xl border border-ink/10 bg-white/65 p-6 shadow-soft">
          <span class="font-jp-serif text-2xl text-sakura/80">{String(index + 1).padStart(2, '0')}</span>
          <p class="mt-4 text-xs font-semibold tracking-[0.16em] text-muted">{date}</p>
          <h2 class="font-jp-serif mt-2 text-2xl tracking-wider">{state}</h2>
          <p class="mt-3 text-sm leading-7 text-muted">{copy}</p>
        </article>
      ))}
    </div>
    <p class="mt-5 text-xs leading-6 text-muted">※上記は例年の目安です。開花・満開日は天候により大きく変わります。</p>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <SectionHeading
      eyebrow="BEST TIME OF DAY"
      title="同じ桜でも、時間で表情が変わる。"
      description="静けさ、写真、食事との組み合わせ。目的に合わせて訪れる時間を選びましょう。"
    />
    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      <article class="rounded-3xl bg-moss-dark p-7 text-white shadow-soft">
        <p class="text-xs font-semibold tracking-[0.2em] text-sakura-soft">06:30 — 09:00</p>
        <h2 class="font-jp-serif mt-3 text-2xl tracking-wider">朝の桜</h2>
        <p class="mt-4 text-sm leading-7 text-white/70">人が少なく、遊歩道の奥行きを撮りやすい時間。通勤・通学、自転車の動線をふさがないよう注意してください。</p>
        <p class="mt-5 text-xs text-white/50">向いている人：写真・静かな散歩</p>
      </article>
      <article class="rounded-3xl border border-ink/10 bg-white/65 p-7 shadow-soft">
        <p class="text-xs font-semibold tracking-[0.2em] text-river-deep">10:00 — 15:00</p>
        <h2 class="font-jp-serif mt-3 text-2xl tracking-wider">昼の桜</h2>
        <p class="mt-4 text-sm leading-7 text-muted">川の青と桜の色が分かりやすく、家族散歩や野外での休憩に向く時間。休日は場所取りと人出が増えます。</p>
        <p class="mt-5 text-xs text-muted">向いている人：初めて・家族・ランチ</p>
      </article>
      <article class="rounded-3xl border border-ink/10 bg-white/65 p-7 shadow-soft">
        <p class="text-xs font-semibold tracking-[0.2em] text-gold">16:00 — 日没</p>
        <h2 class="font-jp-serif mt-3 text-2xl tracking-wider">夕方の桜</h2>
        <p class="mt-4 text-sm leading-7 text-muted">斜めの光で枝と花に立体感が出ます。橋、ビル、水面を一緒に撮りたい日におすすめです。</p>
        <p class="mt-5 text-xs text-muted">向いている人：橋の景色・デート・写真</p>
      </article>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-12 px-5 py-20 lg:grid-cols-2 lg:items-center lg:px-8">
    <figure class="photo-frame aspect-[4/3] shadow-soft">
      <img src="/images/bridge.webp" srcset="/images/bridge-900.webp 900w, /images/bridge.webp 1600w" sizes="(min-width:1024px) 50vw, 100vw" width="1600" height="900" alt="源八橋周辺の大川と桜並木" loading="lazy" />
    </figure>
    <div>
      <SectionHeading eyebrow="THREE VIEWS" title="桜を楽しむ三つの視点" />
      <div class="mt-8 grid gap-6">
        <div class="border-l-2 border-sakura pl-5">
          <h2 class="font-jp-serif text-xl tracking-wider">遊歩道から</h2>
          <p class="mt-2 text-sm leading-7 text-muted">枝の下を歩き、桜のトンネルのような奥行きを楽しみます。立ち止まるときは通路の端へ。</p>
        </div>
        <div class="border-l-2 border-river pl-5">
          <h2 class="font-jp-serif text-xl tracking-wider">橋の上から</h2>
          <p class="mt-2 text-sm leading-7 text-muted">両岸の桜、大川、船、都市景観を一枚に。風が強い日は帽子や持ち物に注意してください。</p>
        </div>
        <div class="border-l-2 border-gold pl-5">
          <h2 class="font-jp-serif text-xl tracking-wider">船を入れて</h2>
          <p class="mt-2 text-sm leading-7 text-muted">水上バスや小型船が通る瞬間は、水都大阪らしい景色になります。運航は季節や天候で変わります。</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 py-20 lg:px-8">
    <SectionHeading eyebrow="HANAMI MANNERS" title="花見を気持ちよく楽しむために" align="center" />
    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {[
        ['火気は使わない', '公園内にバーベキュー可能区域はありません。コンロ、焚き火などの火気は使用できません。'],
        ['通路を広く残す', 'シートや三脚で遊歩道、自転車動線、出入口をふさがないようにします。'],
        ['ごみを持ち帰る', '飲食物、容器、シート類は持ち帰りを基本に。現地の分別案内がある場合は従ってください。'],
        ['桜の枝に触れない', '枝を引く、折る、木に物を掛ける行為は避け、根元の土を踏み固めないよう配慮します。'],
      ].map(([title, copy]) => (
        <article class="rounded-2xl border border-ink/10 bg-white/65 p-6">
          <h2 class="font-jp-serif text-xl tracking-wider">{title}</h2>
          <p class="mt-3 text-sm leading-7 text-muted">{copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8">
    <Notice title="桜ノ宮駅から迷わず歩くなら" tone="sakura">
      <p>西口から大川へ向かい、源八橋付近で川と桜の広がりを確認してから、桜ノ宮ビーチへ。30分コースなら駅へ戻り、時間があれば南へ進みます。</p>
      <a href="/course/#short" class="mt-3 inline-flex font-semibold text-river-deep">30分コースを見る →</a>
    </Notice>
  </section>
</BaseLayout>
